# ---------------------------------------------------------------------------
# DevReaderHub environment configuration
# Copy to `.env.local` and fill in the values. Never commit real secrets.
# ---------------------------------------------------------------------------

# Supabase — Project Settings → API
# Browser + session client (public, publishable key).
NEXT_PUBLIC_SUPABASE_URL=
# Public / publishable key — safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only secret key — used for ingestion and admin writes. Never prefix
# this with NEXT_PUBLIC_ and never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# OpenAI — server-side only, used for the Bangla AI analysis.
OPENAI_API_KEY=
# Model id used for the analysis.
OPENAI_MODEL=gpt-4o-mini
# Optional: OpenAI-compatible gateway (Azure OpenAI, proxy, ...).
# OPENAI_BASE_URL=

# GitHub — optional but recommended. Raises the repository search rate limit
# from 10 requests/minute (authenticated) / 30 per hour (unauthenticated).
GITHUB_TOKEN=

# Cron / scheduled ingestion. Vercel sends this as a Bearer token.
# Generate with: openssl rand -hex 32
CRON_SECRET=

# Collection window in hours (default 24).
INGEST_LOOKBACK_HOURS=24
# Per-request timeout in milliseconds.
INGEST_TIMEOUT_MS=15000
# Retries for transient failures (network errors, 429, 5xx).
INGEST_MAX_RETRIES=3
# Only articles with a pre-analysis importance score >= this value are analysed
# by the AI (1-5). A higher value means lower cost.
AI_IMPORTANCE_THRESHOLD=3
# Maximum number of articles analysed per ingestion run.
AI_MAX_ARTICLES_PER_RUN=40

# Direct Postgres connection string — only used by .
# Supabase Dashboard → Project Settings → Database → Connection string (URI).
DATABASE_URL=

# Public site URL (used for absolute links, metadata and OAuth redirects).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
