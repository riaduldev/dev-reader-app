# ---------------------------------------------------------------------------
# DevPulse environment configuration
# Copy to `.env.local` and fill in the values. Never commit real secrets.
# ---------------------------------------------------------------------------

# Supabase — project settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Service role key: used server-side only (ingestion + admin routes).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# OpenAI — used server-side only for the Bangla AI analysis.
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
# Optional: OpenAI-compatible gateway (e.g. Azure OpenAI / proxy).
# OPENAI_BASE_URL=https://api.openai.com/v1

# GitHub — optional but recommended. Raises the search rate limit from
# 10 requests/minute to 30 requests/minute.
GITHUB_TOKEN=ghp_...

# Cron / scheduled ingestion. Vercel sends this as a Bearer token.
CRON_SECRET=generate-a-long-random-string

# Collection window (hours). Default: 24.
INGEST_LOOKBACK_HOURS=24
# Per-request timeout in milliseconds.
INGEST_TIMEOUT_MS=15000
# Retries for transient failures (network errors, 429, 5xx).
INGEST_MAX_RETRIES=3
# Only articles with a pre-analysis importance score >= this value get an AI
# analysis (1–5). Higher value = lower cost.
AI_IMPORTANCE_THRESHOLD=3
# Maximum number of articles analysed per run.
AI_MAX_ARTICLES_PER_RUN=40

# Public site URL (used for absolute links and metadata).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
